# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
PORT=3000

# SQLite path. Docker / VPS: /data/fitness.db with a volume mounted at /data
DATABASE_PATH=

# Telegram Bot token from @BotFather (required for production initData validation)
TELEGRAM_BOT_TOKEN=

# When true (or when TELEGRAM_BOT_TOKEN is empty), browser demo mode is allowed
ALLOW_DEMO_MODE=true

TZ=Europe/Moscow
PUBLIC_DIR=
VITE_API_URL=

BUSINESS_NAME=Pulse Fitness Club
APP_TITLE=Pulse Fitness Club
APP_DESCRIPTION=Персональный кабинет фитнес-клуба: абонемент, расписание и запись на тренировки.
BRAND_ACCENT=#C6FF4A
BRAND_LOGO_URL=

# local = SQLite is the source of truth. crm = CRM provider stub (501 until an adapter exists).
DATA_MODE=local

# local | webhook | mock
EVENT_ADAPTER=local
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_SECRET=
EVENT_WEBHOOK_TIMEOUT_MS=5000

# local | mock | webhook
NOTIFICATION_ADAPTER=local
NOTIFICATION_WEBHOOK_URL=

FEATURE_DEMO_TOUR=true
FEATURE_DEMO_ADMIN_PREVIEW=true

# Fail-closed for writes. Empty token locks /api/admin writes.
ADMIN_TOKEN=

RETENTION_EXPIRING_DAYS=7
RETENTION_INACTIVE_DAYS=12
RETENTION_LOW_VISITS=2
RETENTION_CANCEL_STREAK=3
RETENTION_NOSHOW_WINDOW_DAYS=30
RETENTION_NOSHOW_COUNT=2

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
